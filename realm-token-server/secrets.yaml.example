# realm-token-server — runtime secrets for the box's .env
#
# Copy to secrets.yaml, fill in, and encrypt with: sops -e -i secrets.yaml
# Restore onto the host by writing each key back as KEY=value in
# ~/apps/realm-token-server/.env  (see README "Restore" below).
#
# The ES256 keypair is the load-bearing item: losing the PRIVATE key
# invalidates every live Realm credential, and re-issuing it forces every
# signed-in client to re-exchange. PEM newlines are stored as literal \n,
# exactly as the .env holds them — src/index.js unescapes at startup.

# ES256 (P-256) keypair. PRIVATE reaches only the /exchange handler.
REALM_JWT_PRIVATE_KEY: ""
REALM_JWT_PUBLIC_KEY: ""

# Same key/secret pair as the box's livekit.yaml.
LIVEKIT_API_KEY: ""
LIVEKIT_API_SECRET: ""

# Only Firebase config needed — verifyIdToken uses Google's public certs.
FIREBASE_PROJECT_ID: ""

# Exact-match browser origins. Under NODE_ENV=production these must be
# https DNS names (no IP literals, nothing under .localhost).
CORS_ALLOWED_ORIGINS: ""
